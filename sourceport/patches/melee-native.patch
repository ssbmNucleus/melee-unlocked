+            HSD_JObjSetFlagsAll(newsel_icon[i], JOBJ_HIDDEN);
+        }
+        return;
+    }
+    newsel_count = count;
+    newsel_pages = 1 + (newsel_count + MNSTAGESEL_NEW_SLOTS - 1) / MNSTAGESEL_NEW_SLOTS;
+    for (i = 0; i < MNSTAGESEL_NEW_SLOTS; i++) {
+        newsel_visible(NUM_STAGES + i, 0);
+    }
+    mu_new_stages_show(-1, 0, newsel_pages);
