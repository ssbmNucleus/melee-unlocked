+/* A fighter script from a mod file can name a command past the fighter tables (59-63 of the
+ * 6-bit opcode), a hitbox past the fighter's four, or a part past its parts block. Each is
+ * logged once per run: an unknown command ends the script (as items do, itanimlist.c), a bad
+ * hitbox command is skipped. */
+static void mu_bad_fighter_command(Fighter* fp, const char* what, u32 value, bool ends)
+{
+    static bool reported;
+    if (!reported) {
+        reported = true;
+        OSReport("fighter kind %d: script %s %u is out of range; %s\n", (int) fp->kind, what,
+                 (unsigned) value, ends ? "its script stops" : "the command is skipped");
+    }
+}
+
+#define MU_FT_COMMANDS 49 /* entries in each table below; asserted after them */
+
+static bool mu_fighter_opcode_ok(Fighter* fp, CommandInfo* cmd, u32 opcode)
+{
+    if (opcode - 10 < MU_FT_COMMANDS) return true;
+    mu_bad_fighter_command(fp, "command", opcode, true);
+    cmd->u = NULL;
+    return false;
+}
+#endif
+
+/* These temporary words are consumed through the disc-layout CmdUnion. */
