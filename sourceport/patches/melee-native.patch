+        if (!newsel_record(i, mnStageSel_803F06D0[i].x0)) {
+            break;
+        }
+    }
+    for (i = 0; i < MNSTAGESEL_NEW_SLOTS && newsel_nodes < MNSTAGESEL_NEW_NODES; i++) {
+        if (!newsel_record(NUM_STAGES + i, newsel_icon[i])) {
+            break;
+        }
+    }
+    if (i < MNSTAGESEL_NEW_SLOTS) {
+        OSReport("new stages: the stage select's icons have more joints than %d; no new stages page\n",
+                 MNSTAGESEL_NEW_NODES);
