+ * the 1P modes, as an m-ex disc's added fighters (mu_ak_css_mode). Online only in Direct and Teams,
+ * and not a fighter that brings code of its own (custom fighters online,
+ * port/runtime/host/online_fighters.h, mu_css_roster_offered); one not every player in the session
+ * has is greyed out (mu_css_roster_grey_frame). */
+static void mu_css_roster_setup(void)
+{
+    const int n = mu_mex_roster_built() ? mu_mex_roster_fighters() : 0;
+    const u8 mode = mnCharSel_804D6CB0->match_type;
+    const int online = mu_slippi_css_online();
+    unsigned int offered;
+    int k, j, m = 0;
+    if (n <= 0 || (!online && mode >= 0xB && mode != TRAINING_MODE)) {
+        return;
+    }
+    offered = mu_css_roster_offered();
+    for (k = 0; k < n && m < CSS_ROSTER_ICONS; k++) {
+        if (k >= 32 || !(offered >> k & 1u)) {
+            continue;
+        }
+#ifdef MU_AKANEIA_FIGHTERS
+        const int ckind = mu_mex_roster_ready(k) ? mu_ak_ckind_from_mex(CKind_Playable_Count + k) : -1;
+        CSSIcon* icon = &icons_retail[0x19 + m];
+        int emblem, i;
+        if (ckind < 0 || !MU_AK_CKIND(ckind) || !mu_ak_ckind_selectable(ckind)) {
+            continue;
+        }
+        /* The emblem animation is by retail character: the frame of one of the same series. */
+        emblem = mu_mex_roster_emblem(k);
+        icon->ft_hudindex = 0;
+        for (i = 0; i < 0x19; i++) {
+            if (icons_retail[i].char_kind == emblem) {
+                icon->ft_hudindex = icons_retail[i].ft_hudindex;
+                break;
+            }
+        }
+        icon->char_kind = (u8) ckind;
+        icon->state = 2;
+        roster_icon_fighter[m++] = (signed char) k;
+#endif
+    }
+    for (j = 0; j < m; j++) {
+        CSSIcon* icon = &icons_retail[0x19 + j];
+        const int right = j & 1, sub = j >> 1;
+        float l = right ? ICONBNDS_COL8_L : ICONBNDS_COL0_L, r = right ? ICONBNDS_COL8_R : ICONBNDS_COL1_L;
+        float u = ICONROWHT_BTM_TOP, d = ICONROWHT_BTM_BTM;
+        if (m > 2) {
+            /* Four small icons a corner: halves of the place a whole icon is drawn in. */
+            const float mid_x = right ? 28.1f : -27.9f, mid_y = 2.5f;
+            if (sub & 1) l = mid_x; else r = mid_x;
+            if (sub & 2) u = mid_y; else d = mid_y;
+        }
+        icon->bound_l = l;
+        icon->bound_r = r;
+        icon->bound_u = u;
+        icon->bound_d = d;
+    }
+    roster_icons = m;
+    css_icon_count = (u8) (0x19 + m);
+    if (m > 0) {
+        OSReport("[roster] character select: %d installed fighters' icons after the retail ones\n", m);
+    }
+}
+
+/* The joint description at a joint index of a model (the order lb_80011E24 counts in). */
+static HSD_Joint* mu_css_joint_at(HSD_Joint* joint, int* index, int want)
+{
+    while (joint != NULL) {
+        if (*index == want) {
+            return joint;
+        }
+        ++*index;
+        if (!(joint->flags & JOBJ_INSTANCE)) {
+            HSD_Joint* found = mu_css_joint_at(DP(joint->child), index, want);
+            if (found != NULL) {
+                return found;
+            }
+        }
+        joint = DP(joint->next);
+    }
+    return NULL;
+}
+
+/* The fighter's picture on every icon-sized texture of an icon's joint. */
+static int mu_css_roster_texture(HSD_JObj* jobj, HSD_ImageDesc* image, const void* pixels)
+{
+    HSD_JObj* child;
+    HSD_DObj* dobj;
+    int set = 0;
+    if (jobj == NULL) {
+        return 0;
+    }
+    if (!(jobj->flags & (JOBJ_PTCL | JOBJ_SPLINE))) {
+        for (dobj = jobj->u.dobj; dobj != NULL; dobj = dobj->next) {
+            HSD_TObj* tobj;
+            for (tobj = dobj->mobj != NULL ? dobj->mobj->tobj : NULL; tobj != NULL; tobj = tobj->next) {
+                /* The picture, not the shade drawn under it (an intensity texture of the same size). */
+                if (tobj->imagedesc != NULL && tobj->imagedesc->width == 64 && tobj->imagedesc->height == 56 &&
+                    tobj->imagedesc->format >= GX_TF_RGB565)
+                {
+                    *image = *tobj->imagedesc;
+                    image->format = GX_TF_RGBA8;
+                    image->mipmap = 0;
+                    DISC_SET(image->image_ptr, (void*) pixels);
+                    tobj->imagedesc = image;
+                    set++;
+                }
+            }
+        }
+    }
+    for (child = jobj->child; child != NULL; child = child->next) {
+        set += mu_css_roster_texture(child, image, pixels);
+    }
+    return set;
+}
+
+/* Scene build: the installed fighters' icons. Each is a copy of Jigglypuff's icon joint (a bottom
+ * row icon no unlock moves), placed whole icons away from where that row's icons are. */
+static void mu_css_roster_build(void)
+{
+    HSD_JObj* near[2] = { NULL, NULL };
+    Vec3 at[2];
+    HSD_Joint* desc;
+    int index = 0, j;
+    if (roster_icons == 0) {
+        return;
+    }
+    lb_80011E24(mnCharSel_804D6CC0, &near[0], icons_retail[20].joint_id_vs, -1);
+    lb_80011E24(mnCharSel_804D6CC0, &near[1], icons_retail[23].joint_id_vs, -1);
+    desc = mu_css_joint_at(DP(mnCharSel_804D6CF5 == 1 ? css_models->regend_menu.joint : css_models->menu.joint),
+                           &index, icons_retail[20].joint_id_vs);
+    if (near[0] == NULL || near[1] == NULL || desc == NULL) {
+        OSReport("[roster] character select: no retail icon joint to copy; the installed fighters have no icon\n");
+        __builtin_memset(&icons_retail[0x19], 0, sizeof(CSSIcon) * (CSS_ROSTER_ICONS + 1));
+        roster_icons = 0;
+        css_icon_count = 0x19;
+        return;
+    }
+    lb_8000B1CC(near[0], NULL, &at[0]);   /* Jigglypuff's icon: the left corner is three icons left of it */
+    lb_8000B1CC(near[1], NULL, &at[1]);   /* Marth's: the right corner is two icons right of it */
+    at[0].x -= 21.0f;
+    at[1].x += 14.0f;
+    for (j = 0; j < roster_icons; j++) {
+        const int right = j & 1, sub = j >> 1;
+        const u32 next = desc->next.raw;
+        const void* pixels = mu_mex_roster_icon(roster_icon_fighter[j]);
+        HSD_GObj* gobj;
+        HSD_JObj* jobj;
+        Vec3 pos = at[right];
+        int set;
+        desc->next.raw = 0;   /* this joint alone, not the icons after it */
+        jobj = HSD_JObjLoadJoint(desc);
+        desc->next.raw = next;
+        gobj = GObj_Create(4, 5, 0x80);
+        HSD_GObjObject_80390A70(gobj, HSD_GObj_JObjKind, jobj);
+        GObj_SetupGXLink(gobj, HSD_GObj_JObjCallback, 1, 0x80);
+        if (roster_icons > 2) {
+            /* An icon's joint is at its top left corner, and so is a half-size one's. */
+            pos.x += (sub & 1) ? 3.5f : 0.0f;
+            pos.y -= (sub & 2) ? 3.5f : 0.0f;
+            HSD_JObjSetScaleX(jobj, HSD_JObjGetScaleX(jobj) * 0.5f);
+            HSD_JObjSetScaleY(jobj, HSD_JObjGetScaleY(jobj) * 0.5f);
+        }
+        HSD_JObjSetTranslateX(jobj, pos.x);
+        HSD_JObjSetTranslateY(jobj, pos.y);
+        HSD_JObjSetTranslateZ(jobj, pos.z);
+        set = pixels != NULL ? mu_css_roster_texture(jobj, &roster_icon_image[j], pixels) : 0;
+        roster_icon_jobj[j] = jobj;
+        roster_icon_pixels[j] = set > 0 ? pixels : NULL;
+        roster_icon_grey[j] = 0;
+        OSReport("[roster] character select: icon %d (installed fighter %d, kind %d) at %.1f, %.1f; %d textures set\n",
+                 0x19 + j, roster_icon_fighter[j], icons_retail[0x19 + j].char_kind, pos.x, pos.y, set);
+    }
+}
+
+/* Every frame: grey out the icon of each installed fighter the online session cannot play now (and
+ * bring it back once it can), and tell the online select which one the local hand is over. The
+ * picture is a console RGBA8 texture (4x4 blocks: 16 AR pairs, then 16 GB pairs); the grey copy is
+ * each pixel's brightness at two fifths, alpha kept. */
+static void mu_css_roster_grey_frame(void)
+{
+    /* Offline every one (but for the tests' MELEE_TEST_ROSTER_GREY, shim/mu_slippi_css.c). */
+    const unsigned int selectable = roster_icons > 0 ? mu_css_roster_selectable() : 0xFFFFFFFFu;
+    int j, hover = -1;
+    for (j = 0; j < roster_icons; j++) {
+        const int k = roster_icon_fighter[j];
+        const u8 grey = (u8) (k >= 0 && k < 32 && !(selectable >> k & 1u));
+        if (grey == roster_icon_grey[j] || roster_icon_pixels[j] == NULL) {
+            continue;
+        }
+        if (grey) {
+            const u8* src = roster_icon_pixels[j];
+            u8* dst = roster_grey_pixels[j];
+            int b, p;
+            for (b = 0; b < (int) sizeof roster_grey_pixels[j]; b += 64) {
+                for (p = 0; p < 16; p++) {
+                    const u8 a = src[b + p * 2], r = src[b + p * 2 + 1];
+                    const u8 g = src[b + 32 + p * 2], bl = src[b + 32 + p * 2 + 1];
+                    const u8 y = (u8) (((r * 77 + g * 150 + bl * 29) >> 8) * 2 / 5);
+                    dst[b + p * 2] = a;
+                    dst[b + p * 2 + 1] = y;
+                    dst[b + 32 + p * 2] = y;
+                    dst[b + 32 + p * 2 + 1] = y;
+                }
+            }
+        }
+        DISC_SET(roster_icon_image[j].image_ptr, (void*) (grey ? (const void*) roster_grey_pixels[j] : roster_icon_pixels[j]));
+        roster_icon_grey[j] = grey;
+        OSReport("[roster] character select: installed fighter %d's icon %s\n", k, grey ? "greyed out (not every player has it)"
+                                                                                       : "selectable again");
+    }
+    if (roster_hover_icon >= 0 && roster_hover_icon < roster_icons && roster_icon_grey[roster_hover_icon]) {
+        hover = roster_icon_fighter[roster_hover_icon];
+    }
+    mu_css_roster_hover(hover);
+    roster_hover_icon = -1;
+}
