+/* An installed fighter's portrait on one portrait mesh. The retail animation picks its own image
+ * again whenever the game sets a frame, so this runs every frame for a door that holds one. */
+static void mu_css_roster_portrait(HSD_JObj* root, u8 joint, int slot, int fighter, int color)
+{
+    HSD_JObj* portrait = NULL;
+    HSD_DObj* dobj;
+    HSD_TObj* tobj;
+    HSD_ImageDesc* image = &roster_portrait_image[slot];
+    const void* pixels;
+    if (root == NULL) {
+        return;
+    }
+    lb_80011E24(root, &portrait, joint, -1);
+    dobj = portrait != NULL ? HSD_JObjGetDObj(portrait) : NULL;
+    tobj = dobj != NULL && dobj->mobj != NULL ? dobj->mobj->tobj : NULL;
+    if (tobj == NULL || tobj->imagedesc == NULL) {
+        return;
+    }
+    pixels = mu_mex_roster_portrait(fighter, color);
+    if (pixels == NULL) {
+        return;
+    }
+    if (tobj->imagedesc != image) {
+        *image = *tobj->imagedesc;
+    }
+    image->width = 136;
+    image->height = 188;
+    image->format = GX_TF_RGBA8;
+    image->mipmap = 0;
+    DISC_SET(image->image_ptr, (void*) pixels);
+    tobj->imagedesc = image;
+}
+
+static void mu_css_roster_portraits(void)
+{
+    const int doors = mnCharSel_804D6CF5 == 1 ? 2 : 4;
+    int i;
+    if (roster_icons == 0) {
+        return;
+    }
+    for (i = 0; i < doors; i++) {
+        const CSSDoor* door = &mnCharSel_803F0DFC.doors[i];
+        int fighter;
+        if (door->sel_icon >= css_icon_count || !CSS_ICON_ROSTER(door->sel_icon)) {
+            continue;
+        }
+        fighter = roster_icon_fighter[door->sel_icon - 0x19];
+        if (mnCharSel_804D6CF5 == 1) {
+            /* The 1P layout (Training): the player's portrait, and the CPU's on its own model. */
+            mu_css_roster_portrait(i == 0 ? mnCharSel_804D6CC0 : mnCharSel_804D6CC4, i == 0 ? 0x2D : 6, i, fighter,
+                                   roster_door_color[i]);
+        } else {
+            mu_css_roster_portrait(mnCharSel_804D6CC0, door->costume_joint, i, fighter, roster_door_color[i]);
+        }
+    }
+}
