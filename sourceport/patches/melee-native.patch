+/* A sound bank (.ssm) from an overlay, an ISO pack or a mod disc names its own sizes and counts.
+ * Its 0x20-byte head (hsd_SynthSFXLoadBuf): sound-table bytes, sample bytes, sound count, first id.
+ * NULL when they hold together, else why not; file_len 0 when not known. Every retail bank
+ * passes. A bank that fails loads with no sounds instead of sizing a buffer from a wrapped sum or
+ * stopping the game on the sample-memory assertion. */
+static const char* synth_sfx_head_check(const be_u32* head, u64 file_len, u64 aram_free)
+{
+    const u64 table = BEV(head[0]), samples = BEV(head[1]), count = BEV(head[2]);
+    if (table < 0x10 || table > 0x100000) {
+        return "its sound table size is out of range";
+    }
+    if (count < 1 || count > 4096 || count * 0x48 > table) {
+        return "its sound count does not fit its table";
+    }
+    if (samples == 0 || samples % 32 != 0) {
+        return "its sample size is not a whole number of blocks";
+    }
+    if (samples > aram_free) {
+        return "its samples do not fit the sound memory";
+    }
+    if (file_len != 0 &&
+        (table + 0x10 > file_len || OSRoundUp32B(table + 0x10) + samples > file_len))
+    {
+        return "its tables run past the file";
+    }
+    return NULL;
+}
+
+/* The sound table: per sound, a channel count, a sample rate and 0x40 bytes per channel. Each
+ * sound has one or two channels (SfxEntryHost::voice[2], and the player's voice arrays) and a rate
+ * of 4 to 48 kHz (retail: 8 to 48), and the table holds them all. */
+static const char* synth_sfx_table_check(const u8* table, u64 size, u32 count)
+{
+    u64 at = 0;
+    u32 i;
+    for (i = 0; i < count; i++) {
+        u32 voices, rate;
+        if (at + 8 > size) {
+            return "its sound table runs past its end";
+        }
+        voices = BEV(*(const be_u32*) (table + at));
+        rate = BEV(*(const be_u32*) (table + at + 4));
+        if (voices < 1 || voices > 2) {
+            return "a sound has other than one or two channels";
+        }
+        if (rate < 4000 || rate > 48000) {
+            return "a sound's sample rate is out of range";
+        }
+        at += 8 + (u64) voices * 0x40;
+        if (at > size) {
+            return "its sound table runs past its end";
+        }
+    }
+    return NULL;
+}
