+    } else if ((mu_online_disconnected() || party || Player_GetStocks(local) != 0) &&
+               (HSD_PadMasterStatus[local].trigger & HSD_PAD_START))
+    {
+        mu_lras_display = true;
+        ifAll_802F3394();
+        gm_801A0FEC(local, 5);
+        lbAudioAx_80024030(5);
+    }
+    return -1;
+}
+
+static void mu_online_init_pause(void)
+{
+    int mode = mu_online_rules_mode();
