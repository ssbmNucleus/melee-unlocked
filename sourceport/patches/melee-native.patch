+/* Every count, offset and table of a pair of banks from a file stays inside the file's data
+ * block (relocating adds the bank's address to, and sets bits in, the words they name). NULL when
+ * they do, else why not. `located`: the words already hold addresses (psInitDataBankLoad). */
+static const char* ps_banks_check(const void* cmdBank, const void* texBank,
+                                  const void* formBank, bool located)
+{
+    const u64 rc = ps_room(cmdBank), rt = ps_room(texBank);
+    u64 count, first, i, num_groups;
+    u32 version;
+
+    if (rc < 12) {
+        return "its command bank is cut short";
+    }
+    version = BEV(*(const be_u16*) cmdBank);
+    if (version == 0) {
+        count = ps_word(cmdBank, 1);
+        first = 2;
+    } else if (version >= 0x40 && version < 0x44) {
+        count = ps_word(cmdBank, 2);
+        first = 3;
+    } else {
+        return "its command bank has an unknown version";
+    }
+    if ((first + count) * 4 > rc) {
+        return "its command list count runs past the file";
+    }
+    for (i = 0; i < count; i++) {
+        const u32 w = ps_word(cmdBank, (int) (first + i));
+        if (w != 0 && ps_offset(w, cmdBank, located) + sizeof(HSD_PSCmdList) > rc) {
+            return "a command list lies outside the file";
+        }
+    }
+
+    if (rt < 4) {
+        return "its texture bank is cut short";
+    }
+    num_groups = ps_word(texBank, 0);
+    if ((1 + num_groups) * 4 > rt) {
+        return "its texture group count runs past the file";
+    }
+    for (i = 1; i <= num_groups; i++) {
+        const u32 w = ps_word(texBank, (int) i);
+        const HSD_PSTexGroup* tg;
+        u64 off, end, ti;
+        if (w == 0) {
+            continue;
+        }
+        off = ps_offset(w, texBank, located);
+        if (off + offsetof(HSD_PSTexGroup, texTable) > rt) {
+            return "a texture group lies outside the file";
+        }
+        tg = (const HSD_PSTexGroup*) ((const u8*) texBank + off);
+        if (tg->palnum > 256) {
+            return "a texture group has more than 256 palettes";
+        }
+        end = tg->num;
+        if (tg->fmt == 8 || tg->fmt - 9 <= 1) {
+            end = (tg->palflag & 1) ? end + 1 : tg->palnum != 0 ? end + tg->palnum : end * 2;
+        }
+        if (off + offsetof(HSD_PSTexGroup, texTable) + end * 4 > rt) {
+            return "a texture table runs past the file";
+        }
+        for (ti = 0; ti < end; ti++) {
+            const u32 t = tg->texTable[ti].raw;
+            if (t != 0 && ps_offset(t, texBank, located) >= rt) {
+                return "a texture lies outside the file";
+            }
+        }
+    }
+
+    if (formBank != NULL) {
+        const u64 rf = ps_room(formBank);
+        if (rf < 4 || ps_word(formBank, 0) != num_groups) {
+            return "its form bank does not match its texture bank";
+        }
+        if ((1 + num_groups) * 4 > rf) {
+            return "its form group count runs past the file";
+        }
+        for (i = 1; i <= num_groups; i++) {
+            const u32 w = ps_word(formBank, (int) i);
+            const HSD_PSFormGroup* fg;
+            u64 off, fi;
+            if (w == 0) {
+                continue;
+            }
+            off = ps_offset(w, formBank, located);
+            if (off + offsetof(HSD_PSFormGroup, formTable) > rf) {
+                return "a form group lies outside the file";
+            }
+            fg = (const HSD_PSFormGroup*) ((const u8*) formBank + off);
+            if (off + offsetof(HSD_PSFormGroup, formTable) + (u64) fg->num * 4 > rf) {
+                return "a form table runs past the file";
+            }
+            for (fi = 0; fi < fg->num; fi++) {
+                const u32 f = fg->formTable[fi].raw;
+                if (f != 0 && ps_offset(f, formBank, located) >= rf) {
+                    return "a form lies outside the file";
+                }
+            }
+        }
+    }
+    return NULL;
+}
