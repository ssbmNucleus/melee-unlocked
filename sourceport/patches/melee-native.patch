+    column = HSD_ArchiveGetPublicAddress(archive->unk0, "GrdIzumiShrine1_CMPR_image");
+    star = HSD_ArchiveGetPublicAddress(archive->unk0, "GrdIzumiStar1_CMPR_image");
+    if (panorama == NULL || column == NULL || star == NULL)
+        return 0;
+    if (((HSD_JObj*) mirror->hsd_obj)->child == NULL ||
