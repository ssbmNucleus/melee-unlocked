+    for (i = 0; i < n; i++) {
+        MnStageSelMexIcon* icon = &mexsel_icons[i];
+        u8 raw[0x20];
+        if (!mu_mex_stage_icon(i, raw)) {
+            break;
+        }
+        icon->x0 = NULL;
+        icon->x4 = mnStageSel_MexBE32(raw + 4);
+        icon->x8 = raw[8];
+        icon->x9 = raw[9];
+        icon->xA = raw[0xA];
+        icon->xB = raw[0xB];
+        icon->xC = mnStageSel_MexBEF(raw + 0xC);
+        icon->x10 = mnStageSel_MexBEF(raw + 0x10);
+        icon->x14 = mnStageSel_MexBEF(raw + 0x14);
+        icon->x18 = mnStageSel_MexBEF(raw + 0x18);
+        icon->ext = mnStageSel_MexBE32(raw + 0x1C);
+        if (icon->x8 == 2) {
