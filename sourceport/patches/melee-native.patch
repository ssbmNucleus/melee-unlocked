+#ifdef MU_NATIVE
+/* m-ex stages (run-source/rel09-stages/LAYER.md): m-ex reads its own ext lookup instead of
+ * stage_id_map (Stage_8022519C+8, Stage_802251B4+14, Stage_802251E8+1C), one 12-byte row
+ * {internal id, 0, 0} per external id, for every id, retail ones included (on both discs those
+ * rows equal stage_id_map). In the mod view each read copies the disc's row into a host-order
+ * entry, so selected_stage.entry can point at it. An added external id (0x11E and up) whose
+ * internal id the native layer cannot load (locked, logged once) and an id past the disc's table
+ * load Battlefield instead, logged: no menu offers such an id, only a forced --match can. In the
+ * retail view this is &stage_id_map[stkind] exactly. */
+static struct StageIdMapEntry mu_stage_ext_pool[MU_MEX_STAGE_EXT_MAX];
+static struct StageIdMapEntry mu_stage_fallback = { Gr_Kind_Battle, 0, 0 };
+
+static struct StageIdMapEntry* mu_stage_entry(StKind stkind)
+{
+    static int logged = -1;
+    struct StageIdMapEntry* entry;
+    int words[3];
+    if (!mu_mex_active()) {
+        /* A stage id past the table (Stamina mode asked the sound code with one) read past its
+         * end and stopped the game; the console read whatever lay there. Battlefield instead. */
+        if ((unsigned) stkind >= ARRAY_SIZE(stage_id_map)) {
+            if (logged != (int) stkind) {
+                logged = (int) stkind;
+                OSReport("[stage] stage id %d is not a stage; Battlefield instead\n", (int) stkind);
+            }
+            return &mu_stage_fallback;
+        }
+        return &stage_id_map[stkind];
+    }
+    if ((int) stkind < 0 || (int) stkind >= MU_MEX_STAGE_EXT_MAX || !mu_mex_stage_ext(stkind, words)) {
+        if ((unsigned) stkind < ARRAY_SIZE(stage_id_map)) {
+            return &stage_id_map[stkind];
+        }
+        if (logged != (int) stkind) {
+            logged = (int) stkind;
+            OSReport("[mex] stage ext %d: not on this disc; Battlefield instead\n", (int) stkind);
+        }
+        return &mu_stage_fallback;
+    }
+    entry = &mu_stage_ext_pool[stkind];
+    entry->grkind = (GrKind) words[0];
+    entry->unk1 = words[1];
+    entry->unk2 = words[2];
+    if ((int) stkind >= MU_MEX_STAGE_EXT_RETAIL && !mu_mex_stage_usable(entry->grkind)) {
+        if (logged != (int) stkind) {
+            const char* why = mu_mex_stage_lock_reason(entry->grkind);
+            const char* name = mu_mex_stage_name(entry->grkind);
+            logged = (int) stkind;
+            OSReport("[mex] stage ext %d (internal %d, %s) is locked: %s; Battlefield instead\n",
+                     (int) stkind, (int) entry->grkind, name != NULL ? name : "?",
