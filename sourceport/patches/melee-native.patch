+#ifdef MU_NATIVE
+/* The console's walk of Jigglypuff's accessory tree, joint by joint (children first, then the next
+ * sibling, climbing back up as needed), for the given number of steps; NULL for no accessory or a
+ * walk that leaves the tree. */
+static HSD_JObj* ftCo_8009DC54_Walk(HSD_JObj* cur, s32 steps)
+{
+    s32 j;
+    for (j = 0; cur != NULL && j < steps; j++) {
+        if (cur->child != NULL) {
+            cur = cur->child;
+            continue;
+        }
+        while (cur != NULL && cur->next == NULL) {
+            cur = cur->parent;
+        }
+        if (cur != NULL) {
+            cur = cur->next;
+        }
+    }
+    return cur;
+}
+#endif
