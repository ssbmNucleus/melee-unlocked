+static u32 HSD_DObjNativeColor(GXColor c)
+{
+    return ((u32) c.r << 24) | ((u32) c.g << 16) | ((u32) c.b << 8) | c.a;
+}
+
+/* Render semantics (mu_rtx_tokens.h, token 0xF3 01): the material its setup just applied, so the
+ * host's ray-traced renderer can light the DObj's draws itself. The textures went out just before,
+ * from HSD_TObjSetup. Returns whether a matching end (0xF3 02) is owed. Only while the host asks. */
+static int HSD_DObjNativeEmitMaterial(HSD_MObj* mobj)
+{
+    HSD_Material* mat;
+    __UINTPTR_TYPE__ address;
+
+    if (mobj == NULL || !mu_native_rtx_semantics()) {
+        return 0;
+    }
+    mat = mobj->mat;
+    address = (__UINTPTR_TYPE__) mobj;
+    GXW_u8(MU_RTX_TOKEN_MATERIAL);
+    GXW_u8(MU_RTX_MATERIAL_BEGIN);
+    GXW_u8(0);
+    GXW_u8(0);
+    GXW_u32(mobj->rendermode);
+    if (mat != NULL) {
+        GXW_u32(HSD_DObjNativeColor(mat->ambient));
+        GXW_u32(HSD_DObjNativeColor(mat->diffuse));
+        GXW_u32(HSD_DObjNativeColor(mat->specular));
+        GXW_f32(mat->alpha);
+        GXW_f32(mat->shininess);
+    } else {
+        GXW_u32(0);
+        GXW_u32(0xFFFFFFFF);
+        GXW_u32(0);
+        GXW_f32(1.0F);
+        GXW_f32(0.0F);
+    }
+    GXW_u32((u32) (address ^ (address >> 32)));
+    return 1;
+}
