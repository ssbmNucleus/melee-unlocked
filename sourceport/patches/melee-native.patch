+#ifdef MU_NATIVE
+/* A fighter file may list 11 dynamics colliders (the assert in ftColl_8007B320), which is what the
+ * console's array in the fighter holds. Natively the array holds 9, so a fighter with more (an
+ * added fighter's: Duck Hunt has 11) keeps all of its colliders here instead, in a set claimed
+ * when the fighter is made. A set belongs to a fighter by its address. At most 12 fighters live
+ * at once (six players, two each) and a new claim takes the set claimed longest ago, so a set
+ * taken over is always a fighter's that is gone. The sets are statics of the image, so a
+ * rollback restores them with the fighters. */
+enum { MU_FT_COLLIDER_SETS = 16, MU_FT_COLLIDER_MAX = 11 };
+static struct {
+    Fighter* fp;
+    Fighter_x1670_t entries[MU_FT_COLLIDER_MAX];
+} mu_ft_collider_sets[MU_FT_COLLIDER_SETS];
+static int mu_ft_collider_next;
+
+static int mu_ft_collider_room(void)
+{
+    return (int) ((__builtin_offsetof(Fighter, x1828) - __builtin_offsetof(Fighter, x1670)) /
+                  sizeof(Fighter_x1670_t));
+}
+
+Fighter_x1670_t* mu_ft_colliders(Fighter* fp)
+{
+    int i;
+    if (fp->x166C <= mu_ft_collider_room()) {
+        return fp->x1670;
+    }
+    for (i = 0; i < MU_FT_COLLIDER_SETS; i++) {
+        if (mu_ft_collider_sets[i].fp == fp) {
+            return mu_ft_collider_sets[i].entries;
+        }
+    }
+    return fp->x1670; /* not reached: mu_ft_colliders_claim ran when the count was set */
+}
+
+/* Called with fp->x166C just set from the fighter file. */
+static void mu_ft_colliders_claim(Fighter* fp)
+{
+    int i;
+    if (fp->x166C > MU_FT_COLLIDER_MAX) {
+        fp->x166C = MU_FT_COLLIDER_MAX;
+    }
+    for (i = 0; i < MU_FT_COLLIDER_SETS; i++) {
+        if (mu_ft_collider_sets[i].fp == fp) {
+            if (fp->x166C <= mu_ft_collider_room()) {
+                mu_ft_collider_sets[i].fp = NULL; /* a new fighter at an old one's address */
+            }
+            return;
+        }
+    }
+    if (fp->x166C > mu_ft_collider_room()) {
+        mu_ft_collider_sets[mu_ft_collider_next].fp = fp;
+        mu_ft_collider_next = (mu_ft_collider_next + 1) % MU_FT_COLLIDER_SETS;
+    }
+}
+#endif
