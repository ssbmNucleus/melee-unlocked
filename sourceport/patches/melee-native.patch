+        lb_8000C1C0(model, layout[i]);
+        newsel_icon[i * 2] = model->child->next;
+        newsel_icon[i * 2 + 1] = model->child;
+        /* the look of a shown stage (frame 2, the first stage picture; the picture itself is replaced) */
+        HSD_JObjReqAnimAllByFlags(model->child->next, 0x10, 2.0F);
+        HSD_JObjReqAnimAllByFlags(model->child, 0x10, 2.0F);
+        HSD_JObjAnimAll(model);
