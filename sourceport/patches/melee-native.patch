+ * Battlefield. A match block from outside the game (a replay, the online match state) is checked
+ * with this before it starts (shim/mu_match_check.c). */
+int mu_stage_id_known(int stkind)
+{
+    return mu_stage_entry((StKind) stkind) != &mu_stage_fallback;
