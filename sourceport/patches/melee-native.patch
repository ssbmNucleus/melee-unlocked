+        struct AXFX_REVSTD_DELAYLINE* c0 = &rv->C[k * 2];
+        struct AXFX_REVSTD_DELAYLINE* c1 = &rv->C[k * 2 + 1];
+        struct AXFX_REVSTD_DELAYLINE* ap0 = &rv->AP[k * 2];
+        struct AXFX_REVSTD_DELAYLINE* ap1 = &rv->AP[k * 2 + 1];
+        const float comb0 = rv->combCoef[k * 2];
+        const float comb1 = rv->combCoef[k * 2 + 1];
+        float lp = rv->lpLastout[k];
+        float* const pre_line = rv->preDelayLine[k];
+        float* pre = rv->preDelayPtr[k];
+        const long pre_time = rv->preDelayTime;
+        float* const pre_last = pre_line + (pre_time - 1);
+        long c0_in = c0->inPoint, c0_out = c0->outPoint, c1_in = c1->inPoint, c1_out = c1->outPoint;
+        long ap0_in = ap0->inPoint, ap0_out = ap0->outPoint, ap1_in = ap1->inPoint, ap1_out = ap1->outPoint;
+        float c0_last = c0->lastOutput, c1_last = c1->lastOutput;
+        float ap0_last = ap0->lastOutput, ap1_last = ap1->lastOutput;
+        int i;
+
+        for (i = 0; i < 160; i++) {
+            const float input = (float) sptr[i];
+            float delayed = input;
+            float a, b, out;
+
+            if (pre_time != 0) {
+                delayed = *pre;
+                *pre++ = input;
+                if (pre == pre_last)
+                    pre = pre_line;
+            }
+            /* comb filters */
+            a = revstd_fmadds(comb0, c0_last, delayed);
+            b = revstd_fmadds(comb1, c1_last, delayed);
+            REVSTD_AT(c0->inputs, c0_in) = a;
+            c0_in += 4;
+            REVSTD_AT(c1->inputs, c1_in) = b;
+            out = REVSTD_AT(c0->inputs, c0_out);
+            c0_out += 4;
+            c1_last = REVSTD_AT(c1->inputs, c1_out);
+            c1_in += 4;
+            c1_out += 4;
+            c0_last = out;
+            out = out + c1_last;
+            if (c0_in == c0->length) c0_in = 0;
+            if (c0_out == c0->length) c0_out = 0;
+            if (c1_in == c1->length) c1_in = 0;
+            if (c1_out == c1->length) c1_out = 0;
+            /* first all-pass */
+            b = revstd_fmadds(allpass, ap0_last, out);
+            REVSTD_AT(ap0->inputs, ap0_in) = b;
+            out = revstd_fnmsubs(allpass, b, ap0_last);
+            ap0_in += 4;
+            ap0_last = REVSTD_AT(ap0->inputs, ap0_out);
+            ap0_out += 4;
+            if (ap0_in == ap0->length) ap0_in = 0;
+            if (ap0_out == ap0->length) ap0_out = 0;
+            /* low-pass, then the second all-pass */
+            out = out * value0_3;
+            out = revstd_fmadds(damping, lp, out);
+            b = revstd_fmadds(allpass, ap1_last, out);
+            lp = out;
+            REVSTD_AT(ap1->inputs, ap1_in) = b;
+            out = revstd_fnmsubs(allpass, b, ap1_last);
+            a = dry * input;
+            ap1_last = REVSTD_AT(ap1->inputs, ap1_out);
+            ap1_in += 4;
+            ap1_out += 4;
+            out = revstd_fmadds(wet, out, a);
+            if (ap1_in == ap1->length) ap1_in = 0;
+            if (ap1_out == ap1->length) ap1_out = 0;
+            sptr[i] = revstd_fctiwz(out);
+        }
+        sptr += 160;
+        c0->inPoint = c0_in;
+        c0->outPoint = c0_out;
+        c1->inPoint = c1_in;
+        c1->outPoint = c1_out;
+        c0->lastOutput = c0_last;
+        c1->lastOutput = c1_last;
+        ap0->inPoint = ap0_in;
+        ap0->outPoint = ap0_out;
+        ap1->inPoint = ap1_in;
+        ap1->outPoint = ap1_out;
+        ap0->lastOutput = ap0_last;
+        ap1->lastOutput = ap1_last;
+        rv->lpLastout[k] = lp;
+        rv->preDelayPtr[k] = pre;
+    }
+}
+#undef REVSTD_AT
+#endif
 
