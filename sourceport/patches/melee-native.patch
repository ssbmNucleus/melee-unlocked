+/* ---- installed skins as costume slots: the X / Y ring (shim/mu_css_skins.c) ---- */
+
+/* A door that may wear an installed skin: a human or computer player's, with a retail fighter, on the
+ * plain select screen (m-ex's and an installed fighter's costumes are their own); on the one-player
+ * layout the player's door, and in Training the computer's second door. A computer player's X / Y
+ * (its coin in hand) is a human's: the retail colours, then the fighter's skins. */
+static int mu_css_door_skinnable(int door)
+{
+    const CSSDoor* d;
+    if (door < 0 || door >= 4) {
+        return 0;
+    }
+    d = &mnCharSel_803F0DFC.doors[door];
+    if ((d->p_kind != 0 && d->p_kind != 1) ||
+        (mnCharSel_804D6CF5 == 1 && door != 0 && !(door == 1 && mnCharSel_804D6CB0->match_type == TRAINING_MODE)) ||
+        d->sel_icon >= CSS_NONE || mex_select != NULL || CSS_ICON_ROSTER(d->sel_icon))
+    {
+        return 0;
+    }
+    return icons[d->sel_icon].char_kind < 26;
+}
+
+/* Another door of fighter `ckind` wears its skin `skin` already: a skin is never on two doors. */
+static int mu_css_skin_taken(int door, int ckind, int skin)
+{
+    int j;
+    for (j = 0; j < 4; j++) {
+        if (j != door && mnCharSel_803F0DFC.doors[j].p_kind != 3 && mu_door_slot[j].ckind == ckind &&
+            mu_css_door_skin(j) == skin)
+        {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* Door `door`'s portrait shows its skin's own picture (the csp.png saved with it), else the retail
+ * picture of its costume. The retail animation picks its own image again whenever the game sets the
+ * door's frame (mnCharSel_8025D5AC), so this runs after that and once a frame; the image it replaced
+ * is put back when the door leaves the skin. */
+static void mu_css_door_portrait(int door)
+{
+    HSD_JObj* portrait = NULL;
+    HSD_DObj* dobj;
+    HSD_TObj* tobj;
+    HSD_ImageDesc* image;
+    const void* pixels;
+    int skin;
+    /* The one-player layout: the player's portrait is joint 0x2D of the screen, Training's computer's
+     * joint 6 of its own door (as mnCharSel_8025D5AC draws them). */
+    const int cpu_door = mnCharSel_804D6CF5 == 1 && door == 1 && mnCharSel_804D6CB0->match_type == TRAINING_MODE;
+    if (door < 0 || door >= 4 || mnCharSel_804D6CC0 == NULL || (mnCharSel_804D6CF5 == 1 && door != 0 && !cpu_door) ||
+        (cpu_door && mnCharSel_804D6CC4 == NULL))
+    {
+        return;
+    }
+#if MU_SQUAD
+    if (mnCharSel_SquadDoorBusy(door)) {
+        return;   /* the door shows a squad fighter (shim/mu_squad_css.c) */
+    }
+#endif
+    skin = mu_css_door_skinnable(door) ? mu_css_door_skin(door) : 0;
+    if (skin == 0 && mu_door_slot[door].saved == NULL) {
+        return;
+    }
+    image = &mu_door_slot_image[door];
+    lb_80011E24(cpu_door ? mnCharSel_804D6CC4 : mnCharSel_804D6CC0, &portrait,
+                cpu_door ? 6 : mnCharSel_804D6CF5 == 1 ? 0x2D : mnCharSel_803F0DFC.doors[door].costume_joint, -1);
+    dobj = portrait != NULL ? HSD_JObjGetDObj(portrait) : NULL;
+    tobj = dobj != NULL && dobj->mobj != NULL ? dobj->mobj->tobj : NULL;
+    if (tobj == NULL || tobj->imagedesc == NULL) {
+        return;
+    }
+    pixels = skin != 0 ? mu_css_skins_portrait(mu_door_slot[door].ckind, skin) : NULL;
+    if (pixels == NULL) {
+        if (tobj->imagedesc == image && mu_door_slot[door].saved != NULL) {
+            tobj->imagedesc = mu_door_slot[door].saved;
+        }
+        mu_door_slot[door].saved = NULL;
+        return;
+    }
+    if (tobj->imagedesc != image) {
+        mu_door_slot[door].saved = tobj->imagedesc;
+        *image = *tobj->imagedesc;
+    }
+    image->width = 136;
+    image->height = 188;
+    image->format = GX_TF_RGBA8;
+    image->mipmap = 0;
+    DISC_SET(image->image_ptr, (void*) pixels);
+    tobj->imagedesc = image;
+}
+
+/* The host serves a port's fighter the skin its door wears (sub 16). What the host was told last is
+ * kept per door, so it is asked only when the door changed; a skin it refuses leaves the door on the
+ * retail colour of the same costume. */
+static void mu_css_door_send(int door)
+{
+    const int online = mu_slippi_css_online();
+    const int port = mu_css_door_port(door);
+    const int ckind = mu_door_slot[door].ckind;
+    int skin = mu_css_door_skinnable(door) ? mu_css_door_skin(door) : 0;
+    if (skin == mu_door_slot[door].sent_skin &&
+        (skin == 0 || (port == mu_door_slot[door].sent_port && ckind == mu_door_slot[door].sent_ckind)))
+    {
+        return;
+    }
+    if (mu_door_slot[door].sent_skin != 0 && mu_door_slot[door].sent_port >= 0 &&
+        mu_door_slot[door].sent_port != port)
+    {
+        mu_css_skins_pick(mu_door_slot[door].sent_port, mu_door_slot[door].sent_ckind, 0, online);
+    }
+    if (skin != 0 && !mu_css_skins_pick(port, ckind, skin, online)) {
+        OSReport("costume slots: door %d: the host refused skin %d of fighter %d; the retail colour\n", door, skin,
+                 ckind);
+        mu_door_slot[door].skin = 0;
+        skin = 0;
+    } else if (skin == 0) {
+        mu_css_skins_pick(port, ckind >= 0 ? ckind : 0, 0, online);
+    }
+    mu_door_slot[door].sent_port = (s8) port;
+    mu_door_slot[door].sent_ckind = (s8) ckind;
+    mu_door_slot[door].sent_skin = (u8) skin;
+}
+
+/* X / Y on a door that may wear a skin, when its fighter has installed skins: the fighter's retail
+ * colours, then its skins in the host's order (install order), passing over a colour or a skin
+ * another door of that fighter has and a skin the host refuses. In Teams the team gives the colour:
+ * the ring is that color, then the skins made for it (online, every skin of the fighter: the host
+ * builds the one picked for the team's color, and only this player sees it). 1: the press was
+ * handled here. */
+static int mu_css_skins_ring(int door, u32 input)
+{
+    CSSDoor* d;
+    int teams, ckind, skins, colours, retail, ring, at, step, tries, team_color = -1, skin;
+    u8 old_costume, old_skin;
+    struct MuDoorSlot old_slot;
+    if (!(input & (HSD_PAD_X | HSD_PAD_Y)) || !mu_css_door_skinnable(door)) {
+        return 0;
+    }
+    d = &mnCharSel_803F0DFC.doors[door];
+    ckind = icons[d->sel_icon].char_kind;
+    if ((skins = mu_css_skins_count(ckind)) <= 0) {
+        return 0;
+    }
+    retail = gm_GetNumCostumesForCKind(ckind);
+    teams = mu_css_skins_teams();
+    if (teams) {
+        int k, offered = 0;
+        team_color = mnCharSel_804D6CB0->vs.start.players[door].color;
+        for (k = 1; k <= skins; k++) {
+            offered |= mu_slippi_css_online() || mu_css_skins_costume(ckind, k) == team_color;
+        }
+        if (!offered) {
+            return 0;   /* nothing for the team's colour: the retail press */
+        }
+    }
+    colours = teams ? 1 : retail;
+    old_costume = d->costume;
+    old_skin = (u8) mu_css_door_skin(door);
+    old_slot = mu_door_slot[door];
+    ring = colours + skins;
+    at = old_skin != 0 ? colours + old_skin - 1 : teams ? 0 : old_costume;
+    step = (input & HSD_PAD_X) ? 1 : ring - 1;
+    skin = -1;
+    for (tries = 1; tries < ring && skin < 0; tries++) {
+        at = (at + step) % ring;
+        if (at < colours) {
+            if (!teams) {
+                d->costume = (u8) at;
+                mu_door_slot[door].skin = 0;
+                if (isDuplicateCostume(door)) {
+                    continue;
+                }
+            }
+            skin = 0;
+        } else {
+            const int k = at - colours + 1;
+            const int costume = mu_css_skins_costume(ckind, k);
+            const int port = mu_css_door_port(door);
+            if (costume < 0 || costume >= retail || (teams && costume != team_color && !mu_slippi_css_online()) ||
+                mu_css_skin_taken(door, ckind, k))
+            {
+                continue;
+            }
+            mu_door_slot[door].ckind = (s8) ckind;
+            mu_door_slot[door].skin = (u8) k;
+            mu_door_slot[door].costume = (u8) costume;
+            mu_door_slot[door].generation = mu_css_skins_generation(ckind);
+            if (!teams) {
+                d->costume = (u8) costume;
+            }
+            /* Asked now, so a skin the host cannot serve is passed over like a taken colour. */
+            mu_door_slot[door].sent_port = (s8) port;
+            mu_door_slot[door].sent_ckind = (s8) ckind;
+            if (mu_css_skins_pick(port, ckind, k, mu_slippi_css_online())) {
+                mu_door_slot[door].sent_skin = (u8) k;
+                skin = k;
+            } else {
+                OSReport("costume slots: fighter %d skin %d (%s) cannot be worn; passed over\n", ckind, k,
+                         mu_css_skins_name(ckind, k));
+                mu_door_slot[door].sent_skin = 0;   /* the host has no pick for the port now */
+                mu_door_slot[door].skin = 0;
+            }
+        }
+    }
+    if (skin < 0) {
+        /* Nothing else free: the door keeps what it had (the host is told again if a refused skin
+         * took its pick away). */
+        d->costume = old_costume;
+        old_slot.sent_port = mu_door_slot[door].sent_port;
+        old_slot.sent_ckind = mu_door_slot[door].sent_ckind;
+        old_slot.sent_skin = mu_door_slot[door].sent_skin;
+        old_slot.saved = mu_door_slot[door].saved;
+        mu_door_slot[door] = old_slot;
+        mu_door_slot[door].skin = old_skin;
+        mu_css_door_send(door);
+        return 1;
+    }
+    if (skin == 0) {
+        mu_door_slot[door].skin = 0;
+    }
+    mu_css_door_send(door);
+    if (d->costume == old_costume && skin == old_skin) {
+        return 1;
+    }
+    mnCharSel_8025DB34((u8) door);   /* the port's costume and the door's picture */
+    sfxMove();
+    /* A skin with its own portrait says which it is there; only one without (the door shows its slot's
+     * retail portrait) has its name under the door for a moment. */
+    mu_skin_label(door, skin != 0 && mu_css_skins_portrait(ckind, skin) == NULL ? mu_css_skins_name(ckind, skin) : "");
+    if (skin != 0) {
+        OSReport("costume slots: door %d wears fighter %d's skin %d (%s), costume %d\n", door, ckind, skin,
+                 mu_css_skins_name(ckind, skin), mnCharSel_803F0DFC.doors[door].costume);
+    }
+    return 1;
+}
+
+/* Once a frame on the select screen: a door that no longer holds what its skin was picked for
+ * (another fighter, colour or team, or a closed door) goes back to the retail colour, the
+ * host hears what changed, and the portraits show the skins' pictures. */
+static void mu_css_door_slots_frame(void)
+{
+    int door;
+    for (door = 0; door < 4; door++) {
+        if (mu_door_slot[door].skin != 0 && (!mu_css_door_skinnable(door) || mu_css_door_skin(door) == 0)) {
+            mu_door_slot[door].skin = 0;
+            mu_skin_label(door, "");
+        }
+#if MU_SQUAD
+        if (mnCharSel_SquadDoorBusy(door) && mu_skin_text_frames[door] > 0) {
+            mu_skin_label(door, "");   /* the door shows a squad fighter: no skin's name under it */
+        }
+#endif
+        mu_css_door_send(door);
+        mu_css_door_portrait(door);
+    }
+}
+
+/* The select screen is built (again): the host forgets every pick (mu_css_skins_screen) and each
+ * door's is sent again; a door keeps its skin from the last visit only while the installed skins are
+ * the same. */
+static void mu_css_door_slots_screen(void)
+{
