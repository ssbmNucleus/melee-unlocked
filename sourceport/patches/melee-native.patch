+/* The joint of icon i (the copy made above for an installed fighter's). */
+static void mu_css_icon_jobj(HSD_JObj* root, HSD_JObj** out, int i)
+{
+    if (CSS_ICON_ROSTER(i)) {
+        *out = roster_icon_jobj[(i - 0x19) % CSS_ROSTER_ICONS];
+        return;
+    }
+    lb_80011E24(CSS_ICON_ROOT(root), out, mnCharSel_804D6CF5 == 1 ? CSS_ICON_JOINT_1P(i) : CSS_ICON_JOINT_VS(i), -1);
+}
