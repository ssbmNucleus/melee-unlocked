+/* A world position the game has already resolved for this frame, without resolving it here (getting
+ * it through HSD_WObjGetPosition can run a joint's matrix setup, which is the game's to do). */
+static int HSD_LObjNativeResolved(HSD_WObj* wobj, Vec3* out)
+{
+    if (wobj == NULL || (wobj->flags & 1) != 0) {
+        out->x = out->y = out->z = 0.0F;
+        return 0;
+    }
+    *out = wobj->pos;
+    return 1;
+}
+
+/* Render semantics (mu_rtx_tokens.h, token 0xF4): the light set just made active for a camera, with
+ * world positions, so the host's ray-traced renderer lights the scene from the game's own lights.
+ * Only while the host asks; reads only. */
+static void HSD_LObjNativeEmitSemantics(void)
+{
+    int i, count = 0;
+
+    if (!mu_native_rtx_semantics()) {
+        return;
+    }
+    for (i = 0; i < MAX_GXLIGHT; i++) {
+        if (active_lights[i] != NULL) {
+            ++count;
+        }
+    }
+    GXW_u8(MU_RTX_TOKEN_LIGHTS);
+    GXW_u8((u8) count);
+    GXW_u8(0);
+    GXW_u8(0);
+    for (i = 0; i < MAX_GXLIGHT; i++) {
+        HSD_LObj* lobj = active_lights[i];
+        Vec3 position, interest;
+        u32 params[6];
+        u8 resolved = 0;
+        __UINTPTR_TYPE__ address;
+        int k;
+
+        if (lobj == NULL) {
+            continue;
+        }
+        if (HSD_LObjNativeResolved(lobj->position, &position)) {
+            resolved |= MU_RTX_LIGHT_POSITION_RESOLVED;
+        }
+        if (HSD_LObjNativeResolved(lobj->interest, &interest)) {
+            resolved |= MU_RTX_LIGHT_INTEREST_RESOLVED;
+        }
+        __builtin_memset(params, 0, sizeof params);
+        __builtin_memcpy(params, &lobj->u, sizeof lobj->u < sizeof params ? sizeof lobj->u : sizeof params);
+        address = (__UINTPTR_TYPE__) lobj;
+        GXW_u8((u8) HSD_LObjGetType(lobj));
+        GXW_u8(lobj->id != GX_LIGHT_NULL ? (u8) HSD_LightID2Index(lobj->id) : 0xFF);
+        GXW_u8(lobj->spec_id != GX_LIGHT_NULL ? (u8) HSD_LightID2Index(lobj->spec_id) : 0xFF);
+        GXW_u8(resolved);
+        GXW_u32(lobj->flags);
+        GXW_u8(lobj->color.r);
+        GXW_u8(lobj->color.g);
+        GXW_u8(lobj->color.b);
+        GXW_u8(lobj->color.a);
+        GXW_f32(position.x);
+        GXW_f32(position.y);
+        GXW_f32(position.z);
+        GXW_f32(interest.x);
+        GXW_f32(interest.y);
+        GXW_f32(interest.z);
+        for (k = 0; k < 6; k++) {
+            GXW_u32(params[k]);
+        }
+        GXW_f32(lobj->shininess);
+        GXW_u32((u32) (address ^ (address >> 32)));
