+ * table again at each visit gives what the console has. */
+static void mnStageSel_MexFill(void)
+{
+    int n = mu_mex_stage_icon_count();
+    int i;
+    if (n > MNSTAGESEL_MEX_MAX) {
+        OSReport("[mex] stage select: %d icons, room for %d; the rest are left out\n", n,
+                 MNSTAGESEL_MEX_MAX - 1);
+        n = MNSTAGESEL_MEX_MAX - 1;
