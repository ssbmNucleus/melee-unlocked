+void psInitDataBankLocate(HSD_Archive* cmdBank, HSD_Archive* texBank,
+                          int* formBank)
+{
+    const u32 version = BEV(*(const be_u16*) cmdBank);
+    u8* list = NULL; /* the command list table: `count` slots */
+    s32 count = 0;
+    s32 num_groups;
+    s32 i;
+
+    {
+        /* A bank pair from a mod file that does not hold together is emptied in place (version 0
+         * with no command lists, no texture groups) instead of relocated, so the load step that
+         * follows sees an empty bank: none of its effects are made. */
+        const char* why = ps_banks_check(cmdBank, texBank, formBank, false);
+        if (why != NULL) {
+            OSReport("particle bank: %s; its effects are not shown\n", why);
+            if (ps_room(cmdBank) >= 12) {
+                ps_set_word(cmdBank, 0, 0);
+                ps_set_word(cmdBank, 1, 0);
+                ps_set_word(cmdBank, 2, 0);
+            }
+            if (ps_room(texBank) >= 4) {
+                ps_set_word(texBank, 0, 0);
+            }
+            return;
+        }
+    }
+
+    if (version == 0) {
+        count = (s32) ps_word(cmdBank, 1);
+        for (i = 0; i < count; i++) {
+            ps_relocate(cmdBank, i + 2, cmdBank);
+        }
+        list = (u8*) cmdBank + 8;
+    } else if (version >= 0x40 && version < 0x44) {
+        /* word 1: ids below the table, word 2: slots in it (read as the archive header's
+         * nb_reloc on the console) */
+        count = (s32) ps_word(cmdBank, 2);
+        for (i = 0; i < count; i++) {
+            ps_relocate(cmdBank, i + 3, cmdBank);
+        }
+        list = (u8*) cmdBank + 12;
+    }
+    /* Mark every command list as not yet interpreted. */
+    for (i = 0; i < count; i++) {
+        const u32 cmd = ps_word(list, i);
+        if (cmd != 0) {
+            void* cl = (void*) (mu_uptr) cmd;
+            ps_set_word(cl, 2, (ps_word(cl, 2) & 0xF1FFFFFF) | 0x08000000);
+        }
+    }
+
+    num_groups = (s32) ps_word(texBank, 0);
+    for (i = 1; i <= num_groups; i++) {
+        ps_relocate(texBank, i, texBank);
+    }
+    for (i = 1; i <= num_groups; i++) {
+        HSD_PSTexGroup* tg = (HSD_PSTexGroup*) (mu_uptr) ps_word(texBank, i);
+        u32 first, end, ti;
+        if (tg == NULL) {
+            continue;
+        }
+        for (ti = 0; ti < tg->num; ti++) {
+            ps_relocate(tg->texTable, ti, texBank);
+        }
+        if (tg->fmt != 8 && tg->fmt - 9 > 1) {
+            continue; /* no palette */
+        }
+        first = tg->num;
+        if (tg->palflag & 1) {
+            end = first + 1;
+        } else if (tg->palnum != 0) {
+            end = first + tg->palnum;
+        } else {
+            end = first * 2;
+        }
+        for (ti = first; ti < end; ti++) {
+            ps_relocate(tg->texTable, ti, texBank);
+        }
+    }
+
+    if (formBank == NULL) {
+        return;
+    }
+    for (i = 1; i <= num_groups; i++) {
+        HSD_PSFormGroup* fg;
+        u32 fi;
+        ps_relocate(formBank, i, formBank);
+        fg = (HSD_PSFormGroup*) (mu_uptr) ps_word(formBank, i);
+        if (fg == NULL) {
+            continue;
+        }
+        for (fi = 0; fi < fg->num; fi++) {
+            ps_relocate(fg->formTable, fi, formBank);
+        }
+    }
+}
