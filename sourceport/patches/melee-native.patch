+ * and moves left by half of that. Widths are the font's character advance at scale 0.4 (640x480 units). */
+#define MU_PRO_ICON_CHARS 1.9f
+#define MU_TAG_ADVANCE 11.5f
+static int mu_nametag_chars(const char* text)
+{
+    int chars = 0;
+    const unsigned char* p = (const unsigned char*) text;
+    while (p != NULL && *p != 0) {
+        p += (*p >= 0x81 && *p <= 0x9F) || (*p >= 0xE0 && *p <= 0xEF) ? 2 : 1;
+        chars++;
+    }
+    return chars;
+}
+static float mu_nametag_fit_slot(int slot)
+{
+    const char* pro = mu_pro_tag_text(slot);
+    if (pro != NULL) {
+        const float n = (float) mu_nametag_chars(pro) + MU_PRO_ICON_CHARS;
+        return n > 4.0f ? 4.0f / n : 1.0f;
+    }
+    return mu_nametag_fit(MU_TAG_TEXT(slot));
+}
+/* How far left the name moves for the robot (640x480 units), 0 without one. */
+static float mu_pro_tag_shift(int slot)
+{
+    if (mu_pro_tag_text(slot) == NULL) return 0.0f;
+    return MU_PRO_ICON_CHARS * MU_TAG_ADVANCE * mu_nametag_fit_slot(slot) * (NAMETAG_TEXT_SCALE_X / 0.4f) * 0.5f;
+}
+/* For the host's robot: its centre's distance right of the tag and its room's width, 640x480 units.
+ * 0 when this tag has none. Display only. */
+int mu_pro_tag_icon(int slot, float* dx, float* width)
+{
+    const char* pro;
+    float f, ws;
+    if (slot < 0 || slot >= Gm_Player_NumMax || (pro = mu_pro_tag_text(slot)) == NULL) return 0;
+    f = mu_nametag_fit_slot(slot);
+    ws = NAMETAG_TEXT_SCALE_X / 0.4f;
+    *dx = (float) mu_nametag_chars(pro) * MU_TAG_ADVANCE * f * ws * 0.5f;
+    *width = MU_PRO_ICON_CHARS * MU_TAG_ADVANCE * f * ws;
+    return 1;
+}
+#define NAMETAG_TEXT_FIT_SLOT(slot) (NAMETAG_TEXT_SCALE_X * mu_nametag_fit_slot(slot))
