+            }
+        }
+    }
+    local = mu_online_rules_local_port();
+    if (local < 0) {
+        return -1;
+    }
+    if (mu_lras_display) {
+        if ((!mu_online_disconnected() && !party && Player_GetStocks(local) == 0) ||
+            (HSD_PadMasterStatus[local].trigger & HSD_PAD_START))
+        {
+            mu_lras_display = false;
+            ifAll_802F33CC();
