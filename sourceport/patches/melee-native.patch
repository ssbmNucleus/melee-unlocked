+ *
+ * A script from a mod file can push more than its stack has slots for, or return and loop with
+ * nothing pushed; either wrote or read past the struct. Such a script ends there (the
+ * interpreters stop at a null command), with one log line per run. */
+static bool mu_command_stack_ok(CommandInfo* info, u32 slots, u32 push, u32 pop)
+{
+    static bool reported;
+    if (info->loop_count >= pop && info->loop_count - pop + push <= slots) {
+        return true;
+    }
+    if (!reported) {
+        reported = true;
+        OSReport("command script: %s (%u of %u stack slots used); the script stops\n",
+                 push != 0 ? "a loop or subroutine nests too deep"
+                           : "a loop end or return has nothing to go back to",
+                 (unsigned) info->loop_count, (unsigned) slots);
+    }
+    info->u = NULL;
+    return false;
+}
