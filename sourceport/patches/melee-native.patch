+                    const char* name = internal < 0 ? NULL : mu_mex_stage_name(internal);
+                    mexsel_logged[i] = 1;
+                    OSReport("[mex] stage select: icon %d (ext %d, internal %d, %s) locked: %s\n", i,
+                             (int) icon->ext, internal, name != NULL ? name : "?",
