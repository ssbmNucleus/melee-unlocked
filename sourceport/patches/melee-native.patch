+/* The retail emblem frame for a retail character: its retail icon's portrait base (the first
+ * costume row of the retail animation, whose emblem is the same for every costume). */
+static int mu_css_retail_emblem(int ckind)
+{
+    int i;
+    for (i = 0; i < 0x19; i++) {
+        if (icons_retail[i].char_kind == ckind) {
+            return icons_retail[i].ft_hudindex;
+        }
+    }
+    return 0;
+}
