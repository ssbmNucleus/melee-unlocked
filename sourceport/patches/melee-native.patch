+static int mu_online_lras_check(void)
+{
+    const u32 lras = HSD_PAD_L | HSD_PAD_R | HSD_PAD_A | HSD_PAD_START;
+    const int party = mu_online_rules_mode() == 4;
+    int i, local;
+    if (party) {
+        if (mu_online_is_leaving()) {
+            return -1;
+        }
+        local = mu_online_rules_local_port();
+        if (local < 0) {
+            return -1;
+        }
+        if ((HSD_PadMasterStatus[local].button & lras) == lras) {
+            /* Sent with the next pad. The match then ends like any other disconnect and cannot
+             * be rolled back past; the flag is kept through rollbacks, so this happens once. */
+            mu_online_leave();
+            /* Hide HUD and pause textures for the time left until the game ends. */
+            ifAll_802F3394();
+            gm_801A10FC(local);
+            return -1;
+        }
+    } else {
+        for (i = 0; i < 4; i++) {
+            if (Player_GetPlayerSlotType(i) != Gm_PKind_Human) {
+                continue;
+            }
+            /* Once disconnected, the stock check is skipped. */
+            if (!mu_online_disconnected() && Player_GetStocks(i) == 0) {
+                continue;
+            }
+            if ((HSD_PadMasterStatus[i].button & lras) == lras) {
+                controller.state.pauser = (s8) i;
