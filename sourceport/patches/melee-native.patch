+#ifdef MU_NATIVE
+#include "mu_gxpipe.h"
+int mu_native_owner_tracking(void);
+int mu_stage_map_tag(void* ground);   /* shim/mu_stage_scenery.c */
+#endif
+
 static inline void render_gobj(HSD_GObj* cur, int i)
 {
     HSD_GObj* saved = HSD_GObj_804D7814;
+#ifdef MU_NATIVE
+    /* Private FIFO token 0xF1 0xFE: the draws that follow belong to an effect object (particles,
+     * smoke, dust), the owner the recompiled build reads from the classifier. Sent only while the
+     * host tracks owners, so the stream is otherwise unchanged. */
+    /* Class 6 items carry gameplay signals (0xFD). Class 8 dispatchers with no user data are
+     * particles (0xFE); class 8 with user data are model effects (0xFC: shields, reflectors and
+     * the glows of moves), the same three owners the recompiled build reads. */
+    int effect = (cur->classifier == 6 || cur->classifier == 8) && mu_native_owner_tracking();
+    /* Private token 0xF7: the draws that follow belong to map gobj n of the stage (0x80 set when it
+     * is scenery, shim/mu_stage_scenery.c), 0xFF after; for the looks that keep only the play plane. */
+    int stage = cur->classifier == 3 && cur->user_data_kind == 3 && cur->user_data != NULL &&
+                mu_native_owner_tracking();
+    if (effect) {
+        GXW_u8(0xF1);
+        GXW_u8(cur->classifier == 6 ? 0xFD : cur->user_data == NULL ? 0xFE : 0xFC);
+    }
+    if (stage) {
+        GXW_u8(0xF7);
+        GXW_u8((u8) mu_stage_map_tag(cur->user_data));
+    }
+#endif
     HSD_GObj_804D7814 = cur;
     cur->render_cb(cur, i);
     HSD_GObj_804D7814 = saved;
+#ifdef MU_NATIVE
+    if (effect) {
+        GXW_u8(0xF1);
+        GXW_u8(0xFF);
+    }
+    if (stage) {
+        GXW_u8(0xF7);
+        GXW_u8(0xFF);
+    }
+#endif
 }
 
