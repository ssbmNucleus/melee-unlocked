+/* m-ex mnStageSel_802599EC (424 bytes, replaces the function): an icon whose external id is one of
+ * the 29 retail rows' takes that row's bit of the random stage mask; one HSD_Randi over the icons
+ * that may be drawn; none: icon 0. The save mask is read as it is (the retail function's "random
+ * stage switch not unlocked" answer is skipped, as on the console). */
+static int mnStageSel_MexRandom(void)
+{
+    static int drawable[MNSTAGESEL_MEX_MAX];
+    const u32 mask = gmMainLib_GetGamePrefs()->stage_mask;
+    int i, j, n = 0, pick;
+    for (i = 0; i < NUM_STAGES; i++) {
+        for (j = 0; j < mexsel_count; j++) {
+            if (mexsel_icons[j].ext == mnStageSel_803F06D0[i].stkind) {
+                mexsel_icons[j].x4 = (mexsel_icons[j].x4 & ~0x40000000u) |
+                                     ((((s32) mask >> mnStageSel_803F06D0[i].xA) & 1u) << 30);
+            }
+        }
+    }
+    for (j = 0; j < mexsel_count; j++) {
+        mexsel_icons[j].x4 &= ~0x80000000u;
+        if (mexsel_icons[j].x4 & 0x40000000u) {
+            drawable[n++] = j;
+        }
+    }
+    if (n == 0) {
+        return 0;
+    }
+    pick = drawable[HSD_Randi(n)];
+    mexsel_icons[pick].x4 |= 0x80000000u;
