backups/
/runtime/
reports/
build/
*.log
__pycache__/
dependencies/

/port/generated/
/port/generated_playback/
/build-review/
/melee/
/slippi/
shadercache/
replays/

/port-settings.ini
/port-settings.ini.tmp

# Streamline runtime binaries are copied from the SDK zip; keep headers/libs/docs only
/port/third_party/streamline/bin/

# Packaged releases (tools/package_release.py)
/release/

# Port run-time user data (memory card, Slippi user folder)
/User/
/melee_port.log

# Private working notes, never published
HANDOFF_*.md
NOTE_FOR_*.md

# Per-agent and per-feature build directories
build-*/
*-build.err

# Cygwin/MSYS crash dumps, written into whatever directory the shell was in
*.stackdump

# Vanilla (no Gecko) translated game, the reference for the native build
/port/generated_vanilla/
# v0.7 generated translation (the removed Static Recomp's) and local user data
/port/generated_07/
/CosmeticMods/
/VideoBackgrounds/
/port-settings.ini.bak

# Launcher social identity / ephemeral presence and service database.
**/lobby-profile.json
**/lobby-game-status.json*
**/lobby.sqlite3*
/Mods/
/run-current-reports/
/run-stage-skins/
/tools/current_report_*.py
/port/third_party/mod_tools/7zr.exe
/port/third_party/mod_tools/xdelta3.exe

# DXC and librashader Windows DLLs and DXC's Linux library, downloaded from the vendors' pinned
# releases and checked by SHA-256 (tools/fetch_graphics_dlls.py); headers and licences are vendored.
# The Linux librashader.so stays tracked (a local build; upstream publishes none).
/port/third_party/dxc/bin/dxcompiler.dll
/port/third_party/dxc/bin/dxil.dll
/port/third_party/librashader/bin/librashader.dll
/port/third_party/dxc/linux/libdxcompiler.so

# Slippi's three menu files are mostly the disc's own assets: the game rebuilds them from the player's
# disc (port/sys_deltas, runtime/host/sysgen.cpp), so a copy put in a Sys folder is never committed.
/port/slippi_sys*/GameFiles/GALE01/GameSetup_gui.dat
/port/slippi_sys*/GameFiles/GALE01/slpCSS.dat
/port/slippi_sys*/GameFiles/GALE01/SlippiCSS_gui.dat

